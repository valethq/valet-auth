{
  "schema": 1,
  "id": "valet-auth",
  "name": "Auth",
  "version": "0.1.0",
  "description": "Identity: owner password, device cookies and scoped bearer tokens.",
  "valet": "^0.1.1",
  "main": "./src/index.ts",
  "provides": ["identity@1", "settings@2"],
  "optionalRequires": ["transport@1"],
  "events": {
    "namespace": "identity"
  },
  "settings": {
    "sections": {
      "system": {
        "subsections": [
          {
            "id": "sessions",
            "label": "Sessions",
            "items": [
              {
                "id": "cookieName",
                "label": "Session cookie name",
                "summary": "Name of the HTTP cookie that holds a device session. Change only if another cookie already uses the default.",
                "input": {
                  "type": "string",
                  "default": "valet_session"
                }
              }
            ]
          }
        ],
        "icon": "lock"
      }
    }
  },
  "acl": {
    "permissions": {
      "device.read": {
        "summary": "List login devices."
      },
      "device.revoke": {
        "summary": "Revoke a login device.",
        "requireVerifiedLogin": true
      },
      "token.read": {
        "summary": "List bearer tokens."
      },
      "token.create": {
        "summary": "Create a capped or tagged bearer token.",
        "requireVerifiedLogin": true
      },
      "token.revoke": {
        "summary": "Revoke a bearer token.",
        "requireVerifiedLogin": true
      },
      "me": {
        "summary": "Read your own principal.",
        "default": "guest"
      }
    }
  }
}
